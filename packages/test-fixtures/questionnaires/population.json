{
  "resourceType": "Questionnaire",
  "id": "population",
  "url": "http://example.org/fhir/qb/Questionnaire/population",
  "version": "1.0.0",
  "status": "draft",
  "title": "Patient intake (population and extraction)",
  "language": "en-NZ",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "patient"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        },
        {
          "url": "description",
          "valueString": "The patient the form is about"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "conditions",
        "language": "application/x-fhir-query",
        "expression": "Condition?patient={{%patient.id}}&clinical-status=active"
      }
    }
  ],
  "item": [
    {
      "linkId": "demographics",
      "type": "group",
      "text": "About you",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-itemExtractionContext",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%patient"
          }
        }
      ],
      "item": [
        {
          "linkId": "given",
          "type": "string",
          "text": "Given name",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.name.given",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.name.first().given.first()"
              }
            }
          ]
        },
        {
          "linkId": "family",
          "type": "string",
          "text": "Family name",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.name.family",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.name.first().family"
              }
            }
          ]
        },
        {
          "linkId": "gender",
          "type": "choice",
          "text": "Gender",
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "female",
                "display": "Female"
              }
            },
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "male",
                "display": "Male"
              }
            },
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "other",
                "display": "Other"
              }
            },
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "unknown",
                "display": "Unknown"
              }
            }
          ],
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.gender",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.gender"
              }
            }
          ]
        },
        {
          "linkId": "birthDate",
          "type": "date",
          "text": "Date of birth",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.birthDate",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.birthDate"
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "conditions",
      "type": "group",
      "text": "Current conditions",
      "repeats": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-itemPopulationContext",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%conditions.entry.resource",
            "name": "condition"
          }
        }
      ],
      "item": [
        {
          "linkId": "condition-name",
          "type": "string",
          "text": "Condition",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%condition.code.text"
              }
            }
          ]
        },
        {
          "linkId": "condition-onset",
          "type": "date",
          "text": "Since",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%condition.onsetDateTime.toString().substring(0, 10)"
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "vitals",
      "type": "group",
      "text": "Measurements",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-observationExtract",
          "valueBoolean": true
        }
      ],
      "item": [
        {
          "linkId": "weight",
          "type": "decimal",
          "text": "Weight",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "29463-7",
              "display": "Body weight"
            }
          ],
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-observationLinkPeriod",
              "valueDuration": {
                "value": 1,
                "unit": "year",
                "system": "http://unitsofmeasure.org",
                "code": "a"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
              "valueCoding": {
                "system": "http://unitsofmeasure.org",
                "code": "kg",
                "display": "kg"
              }
            }
          ]
        },
        {
          "linkId": "height",
          "type": "decimal",
          "text": "Height",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "8302-2",
              "display": "Body height"
            }
          ],
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-observationLinkPeriod",
              "valueDuration": {
                "value": 1,
                "unit": "year",
                "system": "http://unitsofmeasure.org",
                "code": "a"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
              "valueCoding": {
                "system": "http://unitsofmeasure.org",
                "code": "cm",
                "display": "cm"
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "nok",
      "type": "group",
      "text": "Next of kin",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-itemExtractionContext",
          "valueCode": "RelatedPerson"
        }
      ],
      "item": [
        {
          "linkId": "nok-name",
          "type": "string",
          "text": "Name",
          "definition": "http://hl7.org/fhir/StructureDefinition/RelatedPerson#RelatedPerson.name.text"
        },
        {
          "linkId": "nok-relationship",
          "type": "choice",
          "text": "Relationship",
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-RoleCode",
                "code": "SPS",
                "display": "Spouse"
              }
            },
            {
              "valueCoding": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-RoleCode",
                "code": "PRN",
                "display": "Parent"
              }
            },
            {
              "valueCoding": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-RoleCode",
                "code": "CHILD",
                "display": "Child"
              }
            }
          ],
          "definition": "http://hl7.org/fhir/StructureDefinition/RelatedPerson#RelatedPerson.relationship"
        },
        {
          "linkId": "nok-phone",
          "type": "string",
          "text": "Phone",
          "definition": "http://hl7.org/fhir/StructureDefinition/RelatedPerson#RelatedPerson.telecom.value"
        }
      ]
    }
  ]
}
