              {
                "url": "http://hl7.org/fhir/StructureDefinition/translation",
                "extension": [
                  {
                    "url": "lang",
                    "valueCode": "mi"
                  },
                  {
                    "url": "content",
                    "valueString": "Ingoa e pai ana ki a koe"
                  }
                ]
              }
            ]
          },
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-supportLink",
